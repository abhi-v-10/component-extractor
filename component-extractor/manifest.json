{
  "manifest_version": 3,
  "name": "Component Extractor",
  "version": "1.0.0",
  "description": "Visually inspect and extract standalone HTML/CSS UI components from any webpage with clean styling and asset exports.",
  "action": {
    "default_title": "Extract UI Component (Alt+Shift+X)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Extract UI Component"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "component-extractor@local.dev",
      "strict_min_version": "109.0"
    }
  }
}
